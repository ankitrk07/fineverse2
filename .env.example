# ==============================================================================
# FINEVERSE STORE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# None of these keys are required for the current mock frontend layer.
# All fields below are ready for future backend/API service integrations.

# Base Public App URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (Google Analytics / Plausible) [EDIT when ready]
NEXT_PUBLIC_ANALYTICS_ID=

# Future Headless E-commerce (Shopify Storefront API) [EDIT when ready]
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_token_here
SHOPIFY_API_VERSION=2024-07

# Future Payment Gateway (Razorpay India / Cashfree) [EDIT when ready]
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=your_secret_here

# Future Indian Logistics API (Shiprocket / Delhivery) [EDIT when ready]
SHIPROCKET_API_USER=
SHIPROCKET_API_PASSWORD=
